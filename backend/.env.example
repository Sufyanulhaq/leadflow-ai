# Copy to backend/.env and edit. Every value is optional except the admin password.

# Password for the clinic dashboard at /admin. Leave empty and the dashboard is switched off.
LEADFLOW_ADMIN_PASSWORD=

# Optional. Without it, answers come from the built-in offline answerer.
ANTHROPIC_API_KEY=
# LEADFLOW_MODEL=claude-haiku-5-5
# Hard cap on Claude calls per day, so a public demo cannot run up a bill.
# LEADFLOW_AI_DAILY_LIMIT=200

# Slack incoming webhook (or any URL that accepts {"text": "..."}). Must be https.
LEADFLOW_NOTIFY_WEBHOOK_URL=

# Shown in the chat and in safety replies.
# LEADFLOW_CLINIC_NAME=Brightside Dental & Physio
# LEADFLOW_CLINIC_PHONE=01234 567890

# SQLite by default. For Postgres (for example Neon) paste its connection string.
# DATABASE_URL=postgresql://user:password@host/dbname

# Websites allowed to load the chat, comma separated. Default is any site.
# LEADFLOW_ALLOWED_ORIGINS=https://yourclinic.co.uk

# Set to 1 only when running behind a proxy you control (Render, Cloudflare), so rate limits see the real visitor address.
# LEADFLOW_TRUST_PROXY=1

# Load the fictional demo clinic content on first start.
# LEADFLOW_SEED_DEMO=1
